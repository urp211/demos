#EXTM3U
#
# TVmakina - lista de arranque (exemplo)
# -------------------------------------
# Os primeiros canais sao SINAIS DE TESTE gerados pelo proprio TVmakina:
# funcionam SEM rede, SEM internet e SEM descodificadores. Servem para
# confirmar que o video, o som e a interface estao a funcionar neste PC.
#
# Os canais seguintes sao emissores de sinal aberto / servico publico cujos
# enderecos foram retirados do catalogo publico iptv-org
# (https://github.com/iptv-org/iptv, dominio publico / Unlicense).
# NAO foram testados a partir desta maquina de compilacao: um canal pode
# estar offline, geo-bloqueado ou ter mudado de endereco. Se um falhar,
# o TVmakina passa automaticamente ao seguinte (definicoes > "auto-seguinte").
#
# O TVmakina nao distribui canais pagos nem conteudo protegido.
# Importe apenas listas que tem autorizacao para usar.
#

# ------------------------------------------------------------------ testes
#EXTINF:-1 tvg-id="tvmakina.smpte" group-title="Testes (sem rede)",Sinal de teste SMPTE
test:smpte
#EXTINF:-1 tvg-id="tvmakina.barras" group-title="Testes (sem rede)",Barras de cor
test:barras
#EXTINF:-1 tvg-id="tvmakina.ruido" group-title="Testes (sem rede)",Ruido (prova de CPU)
test:ruido
#EXTINF:-1 tvg-id="tvmakina.relogio" group-title="Testes (sem rede)",Relogio
test:relogio

