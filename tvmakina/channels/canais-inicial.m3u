# ------------------------------------------------------------------ multicast UDP
# Estes canais so funcionam com o proxy local ligado (node server/proxy.js)
# e com um fornecedor que emita em multicast na sua rede. Substitua os
# endereços pelos do seu operador (ex.: Meo/MEO Fibra, Vodafone, operadoras locais).
#EXTINF:-1 tvg-id="exemplo.udp1" group-title="Multicast UDP (precisa do proxy)",Exemplo UDP 239.1.1.1:1234
udp://@239.1.1.1:1234
#EXTINF:-1 tvg-id="exemplo.udp2" group-title="Multicast UDP (precisa do proxy)",Exemplo UDP 232.0.0.1:5000 com interface
udp://@232.0.0.1:5000?interface=192.168.1.10

# ------------------------------------------------------------------ ficheiros locais
# O TVmakina tambem toca ficheiros do proprio computador. Exemplos (descomente
# e ajuste o caminho; no Windows use barras para a frente):
#EXTINF:-1 group-title="Ficheiros locais",Exemplo de ficheiro local
file:///C:/Videos/exemplo.mp4
