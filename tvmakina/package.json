{
  "name": "tvmakina",
  "productName": "TVmakina",
  "version": "1.0.0",
  "description": "Leitor IPTV leve para Windows 7 e PCs fracos: M3U/M3U8, HLS, multicast UDP via proxy local, ficheiros locais, sinais de teste e gravacao.",
  "private": true,
  "main": "electron.cjs",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "check": "node build/check-es5.js",
    "test": "node --test --test-force-exit \"test/*.test.mjs\"",
    "build": "node build/single-file.js",
    "verify": "npm run check && npm test && npm run build",
    "serve": "node server/proxy.js --port 4022",
    "icons": "node build/make-icons.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --ia32",
    "dist:win64": "npm run build && electron-builder --win nsis portable --x64",
    "pack:dir": "npm run build && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "jsdom": "^24.1.3"
  },
  "optionalDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "pt.tvmakina.desktop",
    "productName": "TVmakina",
    "copyright": "TVmakina - software livre",
    "artifactName": "TVmakina-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "icons"
    },
    "files": [
      "index.html",
      "app/**/*",
      "styles/**/*",
      "vendor/**/*",
      "channels/**/*",
      "icons/**/*",
      "electron/**/*",
      "electron.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/proxy.js",
        "to": "proxy/proxy.js"
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TVmakina",
      "artifactName": "TVmakina-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TVmakina-Portatil-${version}-${arch}.${ext}"
    }
  }
}
